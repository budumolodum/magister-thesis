@{
    ViewData["Title"] = ViewBag.Title ?? "Дані";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card text-center shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h3>@ViewBag.Title</h3>
                </div>
                <div class="card-body">
                    <h1 class="display-4 text-primary">
                        @if (ViewBag.Value is IFormattable formattable)
                        {
                            @formattable.ToString("N0", null) <small class="text-muted">грн</small>
                        }
                        else
                        {
                            @ViewBag.Value <small class="text-muted">грн</small>
                        }
                    </h1>
                    @if (ViewBag.Description != null)
                    {
                        <p class="text-muted mt-3">@ViewBag.Description</p>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-outline-secondary">Назад до аналітики</a>
                </div>
            </div>
        </div>
    </div>
</div>