@model IEnumerable<WebApplication1.Models.Task>
@{
    ViewData["Title"] = "Завдання";

    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentProjectId = ViewData["CurrentProjectId"] as int?;
    var currentEmployeeId = ViewData["CurrentEmployeeId"] as int?;
    var currentStatus = ViewData["CurrentStatus"] as bool?;
    var currentMonth = ViewData["CurrentMonth"] as int?;
    var currentYear = ViewData["CurrentYear"] as int?;
    var currentSort = ViewData["CurrentSort"] as string;

    string GetSortParam(string sort) => sort == currentSort ? sort + "_desc" : sort;

    // Функція для побудови URL
    string BuildUrl(string sortOrder = null)
    {
        var query = new Dictionary<string, string>
                {
                    ["searchString"] = currentSearch ?? "",
                    ["projectId"] = currentProjectId?.ToString() ?? "",
                    ["employeeId"] = currentEmployeeId?.ToString() ?? "",
                    ["status"] = currentStatus?.ToString().ToLower() ?? "",
                    ["month"] = currentMonth?.ToString() ?? "",
                    ["year"] = currentYear?.ToString() ?? ""
                };

        if (sortOrder != null)
            query["sortOrder"] = sortOrder;

        var url = Url.Action("Index", "Tasks", query);
        return url ?? "#";
    }
}

<h2>Завдання</h2>

<!-- ФОРМА ФІЛЬТРІВ -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Пошук</label>
            <input name="searchString" class="form-control" value="@currentSearch" placeholder="Назва..." />
        </div>
        <div class="col-md-2">
            <label class="form-label">Проєкт</label>
            <select name="projectId" class="form-select" asp-items="ViewBag.Projects">
                <option value="">Всі</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Працівник</label>
            <select name="employeeId" class="form-select" asp-items="ViewBag.Employees">
                <option value="">Всі</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Статус</label>
            <select name="status" class="form-select">
                <option value="">Всі</option>
                <option value="true" selected="@(currentStatus == true)">Виконано</option>
                <option value="false" selected="@(currentStatus == false)">В процесі</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Місяць</label>
            <select name="month" class="form-select" asp-items="ViewBag.Months">
                <option value="">Всі</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Рік</label>
            <select name="year" class="form-select" asp-items="ViewBag.Years">
                <option value="">Всі</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Фільтрувати</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Очистити</a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Створити завдання</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                <a href="@BuildUrl(GetSortParam("name"))">Назва</a>
            </th>
            <th>Опис</th>
            <th>
                <a href="@BuildUrl(GetSortParam("status"))">Статус</a>
            </th>
            <th>
                <a href="@BuildUrl(GetSortParam("employee"))">Працівник</a>
            </th>
            <th>
                <a href="@BuildUrl(GetSortParam("project"))">Проєкт</a>
            </th>
            <th>Початок</th>
            <th>Кінець</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    <span class="badge @(item.Status ? "bg-success" : "bg-secondary")">
                        @(item.Status ? "Виконано" : "В процесі")
                    </span>
                </td>
                <td>@item.Employee?.Name</td>
                <td>@item.Project.Name</td>
                <td>@item.StartDate?.ToString("dd.MM.yyyy")</td>
                <td>@item.EndDate?.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Деталі</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Немає завдань за вибраними фільтрами.</div>
}