@model WebApplication1.Models.Task
@{
    ViewData["Title"] = "Видалити завдання";
}

<h2>Видалити завдання</h2>
<h3>Ви впевнені?</h3>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Назва</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Опис</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Статус</dt>
        <dd class="col-sm-10">
            <span class="badge @(Model.Status ? "bg-success" : "bg-secondary")">
                @(Model.Status ? "Виконано" : "В процесі")
            </span>
        </dd>

        <dt class="col-sm-2">Працівник</dt>
        <dd class="col-sm-10">@(Model.Employee?.Name ?? "—")</dd>

        <dt class="col-sm-2">Проєкт</dt>
        <dd class="col-sm-10">@Model.Project.Name</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Видалити</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>