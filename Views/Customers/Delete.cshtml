@model WebApplication1.Models.Customer
@{
    ViewData["Title"] = "Видалити замовника";
}

<h2>Видалити замовника</h2>
<h3>Ви впевнені?</h3>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Телефон</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Проєктів</dt>
        <dd class="col-sm-10">@Model.Projects.Count</dd>
    </dl>

    @if (Model.Projects.Any())
    {
        <div class="alert alert-warning">
            Увага: буде видалено @Model.Projects.Count проєкт(ів) та всі їхні завдання!
        </div>
    }

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Видалити</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>