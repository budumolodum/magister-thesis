@model IEnumerable<WebApplication1.Models.Customer>

@{
    ViewData["Title"] = "Замовники";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentSort = ViewData["CurrentSort"] as string;
    string GetSortParam(string sort) => sort == currentSort ? sort + "_desc" : sort;
}

<h2>Замовники</h2>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Пошук</label>
            <input name="searchString" class="form-control" value="@currentSearch" placeholder="Ім'я, телефон, email..." />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Шукати</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Очистити</a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Додати замовника</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>
                <a asp-route-sortOrder="@GetSortParam("name")"
                   asp-route-searchString="@currentSearch">
                    Ім'я
                </a>
            </th>
            <th>
                <a asp-route-sortOrder="@GetSortParam("phone")"
                   asp-route-searchString="@currentSearch">
                    Телефон
                </a>
            </th>
            <th>
                <a asp-route-sortOrder="@GetSortParam("email")"
                   asp-route-searchString="@currentSearch">
                    Email
                </a>
            </th>
            <th>Проєктів</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Projects.Count</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Деталі</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Немає замовників.</div>
}